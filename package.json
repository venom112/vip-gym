{
  "name": "vip-gym-deductions",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute vip-gym --local --file=schema.sql",
    "db:remote": "wrangler d1 execute vip-gym --remote --file=schema.sql",
    "db:import": "wrangler d1 execute vip-gym --remote --file=private/import-existing-data.sql",
    "deploy:ci": "wrangler d1 execute vip-gym --remote --file=schema.sql && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
